{
    "name": "@browsercore/testing",
    "version": "0.2.0",
    "description": "Protocol verification — RFC compliance tests, browser golden packet captures, integration tests, and benchmarking.",
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsercore-testing.git"
    },
    "homepage": "https://github.com/jverneuer/browsercore-testing#readme",
    "bugs": {
        "url": "https://github.com/jverneuer/browsercore-testing/issues"
    },
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "bin",
        "captures",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json",
        "prepublishOnly": "npm run clean && npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "oxlint --type-aware src/",
        "coverage-md": "./bin/coverage-md.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "@browsercore/compression": "0.2.0",
        "@browsercore/cookies": "0.2.0",
        "@browsercore/crypto": "0.2.1",
        "@browsercore/fetch": "0.2.1",
        "@browsercore/http1": "0.2.0",
        "@browsercore/http2": "0.2.1",
        "@browsercore/profiles": "0.2.0",
        "@browsercore/tls": "0.3.1",
        "@browsercore/transport": "0.2.3"
    }
}
