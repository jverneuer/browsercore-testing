{
  "name": "@browsercore/testing",
  "version": "0.1.0",
  "description": "Protocol verification — RFC compliance tests, browser golden packet captures, integration tests, and benchmarking.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@browsercore/cookies": "^0.1.0",
    "@browsercore/crypto": "^0.1.0",
    "@browsercore/fetch": "^0.1.0",
    "@browsercore/http1": "^0.1.0",
    "@browsercore/http2": "^0.1.0",
    "@browsercore/profiles": "^0.1.0",
    "@browsercore/tls": "^0.1.0",
    "@browsercore/transport": "^0.1.0"
  }
}
